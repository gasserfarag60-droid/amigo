# Local development. npm start loads .env automatically (Node 22.9+).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Production: NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# Bind a private interface / 0.0.0.0 only when your deployment needs it.
# TRUST_PROXY=loopback
# Only trust exact reverse-proxy addresses or CIDRs; leave unset otherwise.
# DATA_DIR=C:/amigo/data
