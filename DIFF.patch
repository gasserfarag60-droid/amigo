-.collage-inner { position: relative; width: 340px; height: 340px; max-width: 100%; }
-.tile { position: absolute; border-radius: 16px; box-shadow: 0 10px 24px rgba(0,0,0,.12); overflow: hidden; }
-.tile.phone { width: 168px; height: 250px; right: 18px; top: 0; background: linear-gradient(160deg,#b8c6ff,#dfe7ff); }
