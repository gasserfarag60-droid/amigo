-.pill { position: absolute; background: #6b3df5; color: #fff; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 20px; right: 30px; top: 22px; display: flex; align-items: center; gap: 5px; }
-.react { position: absolute; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 14px rgba(0,0,0,.16); font-size: 22px; }
-.react.laugh { width: 46px; height: 46px; background: #fdd94d; left: 10px; top: 30px; }
